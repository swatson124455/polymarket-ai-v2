# CONCENTRATED-CLIFF MODE — env deltas vs live.env (operator option (a) + 5x40ct sizing,
# both named 2026-08-19). TEMPLATE ONLY: applied to /opt/pa2-maker-kalshi-live/live.env at
# deploy time, with the operator's relight GO, after shadow. Every key below is a DELTA;
# everything not listed keeps its current live.env value (halt $10/day, OBS_HOLD, EST_FEED
# 3-state, post-only, KALSHI_LIVE_ARMED three-lock all UNCHANGED).
#
# Tier-2 trade-universe gating changes (rollback: restore live.env from its dated .bak and
# restart — the deploy script keeps one per change, same discipline as every prior deploy).

# SELECTION — survivable classes only (D3 measured list), close<=8d LOCKED, runway>=49h
# LOCKED (new gate, commit 24ea507), near-strike overlay live (new gate, commit 725a7a1).
KALSHI_SERIES_ALLOW=KXAAAGASD,KXAAAGASW,KXTOPMODEL,KXCLAYTONDNI,KXDIESELW,KXUSDJPY,KXCLARITYVOTE
KALSHI_MAX_DAYS_TO_CLOSE=8
KALSHI_MIN_RUNWAY_H=49
KALSHI_MID_BAND_OUT=0.10,0.90

# TRAVERSAL (operator-ratified 2026-08-19, decisions 1A/3A after the 0-quote shadow day):
# NETEV off for this mode — family table is ~94% defect-era basis (Study B), and it was
# blocking the only otherwise-quotable candidates. Wider pivot pool + far-first ordering +
# coverage floor 3 so the <=3-per-event slots go to the extreme strikes instead of burning
# on mid-band-excluded near-money members (PER_SERIES_CAP itself STAYS 3 = the F15 cap).
KALSHI_NETEV_GATE=0
KALSHI_PIVOT_POOL_MULT=10
KALSHI_PIVOT_COVERAGE=3
KALSHI_PIVOT_FAR_FIRST=1

# FOOTPRINT — 5 markets (operator capital decision 2026-08-19: 5x40ct ~= $200 of the
# $246.81 balance, ~$46 re-quote buffer), <=3 per series (F15 per-event cap; for the
# in-window weeklies one series == one event, the binding case F9 found).
KALSHI_FOOTPRINT_TOP=5
KALSHI_PER_SERIES_CAP=3

# CLIFF GATE — NOT the in-quoter presence gate (section review 2026-08-19): PRESENCE_GATE
# is scoped `and not void`, and the F9 candidates are void (sub-target) books — it would
# never run on them; worse, its _expected_credit_usd projection embeds the exact
# sub-target-pays-nobody premise R1 refuted, so arming it would model $0 and block the
# whole candidate set. PRESENCE_GATE therefore STAYS OFF (live default). Cliff gating in
# this mode is the three-instrument stack that survives that refutation:
#   entry  — the F9 selection projection (runway x measured rate >= $1.50, frozen JSON);
#   size   — OBS_HOLD rung advance only on est-feed PROVEN accrual >= $1.20 (unchanged);
#   pacing — daily reward_pnl SUBCLIFF read (md5 1ecd8060, 07:30Z) + operator-NAMED
#            eviction (automating mid-window eviction would violate the
#            no-mid-window-size-change rule).
# MIN_CREDIT_USD=1.50 is still declared: plan rows stamp it as presence_floor_usd, putting
# the mode's floor on the telemetry record even with the gate off.
KALSHI_MIN_CREDIT_USD=1.50
# EXPLICIT because live.env carries PRESENCE_GATE=1 from the 08-12 window (verified on-box
# 2026-08-19 shadow cycle 1 — the earlier \"live default\" wording in this file was wrong):
KALSHI_PRESENCE_GATE=0
# Closed world: the probe exception admits NON-allowlist series at probe size (shadow cycle 1
# admitted KXMAMDANIEO); concentrated-cliff is allowlist-absolute.
KALSHI_ALLOW_PROBE_EXCEPTION=0

# QUALIFICATION — bypass the CFTC-snapshot unqualifiable skip (R1 refuted its premise;
# commit and call-site comment carry the evidence). The F9 candidates are sub-target books.
KALSHI_QUALIFIABLE_GATE=0

# SIZE — 40ct target via the existing D3 ramp (rung advance stays OBS_HOLD-gated on
# est-feed accrual >= $1.20, so size only ramps in markets PROVEN to be accruing).
KALSHI_JOIN_SIZE=40
KALSHI_D3_RUNGS=5,10,25,40

# CAPITAL — F15 caps: per-market <=$60 hard, whole book <=$200 (the operator deploy number).
KALSHI_MAX_MARKET_CAPITAL=60
KALSHI_MAX_ACTIVATE_CAPITAL=60
KALSHI_MAX_TOTAL_CAPITAL=200

# PRICE BAND — widened for the extreme-price candidate shape (rich bids ~0.99, cheap bids
# ~0.01; the live 0.04/0.96 band refuses ALL 25 F9 candidates). Justified by the cliff
# canon's reinterpretation of the W10 extreme-price zero-credit band (sub-$1 accrual, not
# unscorable extremes) + the TOPMODEL-26AUG31 extreme-price existence proof that PAID.
KALSHI_MAX_PRICE_DOLLARS=0.995
KALSHI_MIN_PRICE_DOLLARS=0.003
