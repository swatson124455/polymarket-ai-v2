[Unit]
Description=Polymarket AI V2 — WeatherBot
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=polymarket
Group=polymarket
WorkingDirectory=/opt/polymarket-ai-v2
Environment=PYTHONUNBUFFERED=1
Environment="PYTHONWARNINGS=ignore::UserWarning:sklearn,ignore::FutureWarning:sklearn"
EnvironmentFile=/opt/pa2-shared/.env
EnvironmentFile=/opt/pa2-shared/.env.weather
ExecStart=/opt/polymarket-ai-v2/venv/bin/python main.py
Restart=always
RestartSec=10
TimeoutStopSec=30
StartLimitIntervalSec=300
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
# /opt/pa2-maker-feeds: WeatherBot appends its per-market forecast to the
# Maker-owned drop /opt/pa2-maker-feeds/wb_forecasts.jsonl (S231). It was added
# to the LIVE unit on the VPS then but never to this committed copy, so every
# deploy.sh run (which cp's this file over /etc/systemd/system/) silently
# reverted it — ProtectSystem=strict then makes the path read-only and the
# export fails invisibly, because _export_forecast_for_maker swallows all
# errors by design so it can never touch the trading path.
ReadWritePaths=/opt/pa2-shared/data /opt/pa2-shared/saved_models /var/log/polymarket /opt/pa2-maker-feeds
PrivateTmp=true

# Resource limits
MemoryMax=2G
CPUQuota=60%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-weather

[Install]
WantedBy=multi-user.target
