# ── MirrorBot v3 silo environment (ALLOWLIST — copy to /opt/pa2-shared/.env.mirror3) ──
#
# RULES (mirror_v3/env_guard.py enforces the first two at boot):
#  1. This is the ONLY EnvironmentFile the polymarket-mirror3 unit loads.
#     Nothing is inherited from /opt/pa2-shared/.env — every value the bot
#     needs is copied here DELIBERATELY. Absent key = boot error, not default.
#  2. The safety trio below must be explicitly present. The bot refuses to
#     boot on drift (unset), on auto-advance, or on live-without-ack.
#  3. Adding a knob here is a Tier-2 config change (CLAUDE.md protocol).

# ── Safety trio (REQUIRED, validated) ──────────────────────────────────────
SIMULATION_MODE=true
CANARY_AUTO_ADVANCE=false
CANARY_STAGE=0
# To go live (ONLY after the acceptance gate passes — MB_REBUILD_PLAN.md §2):
# set SIMULATION_MODE=false AND uncomment the ack. Both, deliberately.
# MIRROR3_LIVE_ACK=I-UNDERSTAND-THIS-TRADES-REAL-MONEY

# ── Identity / registry ────────────────────────────────────────────────────
# v3 runs in its own unit; the shared main.py fleet must NOT also start it.
BOT_ENABLED_MIRROR=false

# ── Connections (REQUIRED — copy real values from the shared .env by hand) ─
DATABASE_URL=postgresql+asyncpg://CHANGE_ME
# RTDS trade firehose (same shared endpoint the verified rtds_websocket uses)
RTDS_WS_URL=wss://ws-live-data.polymarket.com

# ── Sizing (paper validates REAL sizing — operator decision 4) ─────────────
# Code-default Kelly sizing; do NOT copy v2's de-risked flat-$1 end-state.
# BOT_BANKROLL_CONFIG is intentionally NOT set here: v3 uses code defaults
# until the paper phase measures sizing behavior.

# ── Deliberately absent (v2 poison — do not copy) ──────────────────────────
# MIRROR_* tuning knobs        : the ~30 drifted v2 values encode the dying
#                                bot's end-state; v3 starts from code defaults
#                                and tunes per Tier-1 protocol with evidence.
# TRADING_PHASE                : v3 derives mode from SIMULATION_MODE alone.
# PSEUDO_LABEL_ENABLED         : stays false/absent (CLAUDE.md).
