# Paper Maker sim V3 (WebSocket arm) — PAPER ONLY, 100% separate from v1/v2.
# Stop:   sudo touch /opt/pa2-maker-sim-v3/STOP        (loop exits cleanly)
# Kill:   sudo systemctl disable --now polymarket-maker-sim-v3.service
[Unit]
Description=Polymarket Paper Maker Sim V3 WebSocket arm (read-only, no trading)
After=network-online.target

[Service]
Type=simple
User=polymarket
Group=polymarket
WorkingDirectory=/opt/pa2-maker-sim-v3
ExecStart=/opt/pa2-maker-sim-v3/venv/bin/python /opt/pa2-maker-sim-v3/maker_paper_sim_v3.py --run
Restart=on-failure
RestartSec=30
ProtectSystem=strict
ReadWritePaths=/opt/pa2-maker-sim-v3
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
MemoryMax=384M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
