# Paper Maker sim V6 (NEGRISK LAB) — PAPER ONLY, 100% separate from v1-v5.
# Stop:   sudo touch /opt/pa2-maker-sim-v6/STOP        (loop exits cleanly)
# Kill:   sudo systemctl disable --now polymarket-maker-sim-v6.service
[Unit]
Description=Polymarket Paper Maker Sim V6 NEGRISK LAB arm (netted multi-outcome, paired) (read-only, no trading)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=polymarket
Group=polymarket
WorkingDirectory=/opt/pa2-maker-sim-v6
ExecStart=/opt/pa2-maker-sim-v6/venv/bin/python /opt/pa2-maker-sim-v6/maker_paper_sim_v6.py --run
Restart=on-failure
RestartSec=30
ProtectSystem=strict
ReadWritePaths=/opt/pa2-maker-sim-v6
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
MemoryMax=384M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
