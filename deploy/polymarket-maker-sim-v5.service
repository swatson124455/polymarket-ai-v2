# Paper Maker sim V5 (GATE LAB) — PAPER ONLY, 100% separate from v1-v4.
# Stop:   sudo touch /opt/pa2-maker-sim-v5/STOP        (loop exits cleanly)
# Kill:   sudo systemctl disable --now polymarket-maker-sim-v5.service
[Unit]
Description=Polymarket Paper Maker Sim V5 GATE LAB arm (6 gate policies, paired) (read-only, no trading)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=polymarket
Group=polymarket
WorkingDirectory=/opt/pa2-maker-sim-v5
ExecStart=/opt/pa2-maker-sim-v5/venv/bin/python /opt/pa2-maker-sim-v5/maker_paper_sim_v5.py --run
Restart=on-failure
RestartSec=30
ProtectSystem=strict
ReadWritePaths=/opt/pa2-maker-sim-v5
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
MemoryMax=384M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
