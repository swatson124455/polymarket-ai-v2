# esports_silo — fire the collection pass every 15 min (tune OnUnitActiveSec to taste).
#
# QUOTA — pinnodds (the odds source since 2026-07-06): the collector makes ONE
# /markets?sport_id=11 call per pass (all esports events in one response), so a 15-min
# cadence = 96 odds calls/day — trivially under pinnodds' ~20-req/window rate limit.
# (The old OddsPapi per-fixture fan-out that made quota a problem is gone.) Polymarket
# Gamma is keyless/quota-free; the results collector uses PandaScore (its own key).
#   systemctl enable --now esports-silo-collect.timer
[Unit]
Description=Schedule esports_silo collection pass

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
Persistent=true
Unit=esports-silo-collect.service

[Install]
WantedBy=timers.target
