# esports_silo — cron alternative to the systemd timer (pick ONE, not both).
# Every 15 minutes: load env, run one append-only collection pass. Collect-only — trades
# nothing (SILO_ENTRY_HALT on until skill gates pass). Adjust paths for your box.
#
#   crontab -e   # then paste the line below
#
*/15 * * * * cd /home/ubuntu/esports_silo_src && set -a && . /opt/esports_silo/.env && set +a && /opt/pa2-esports-shared/venv/bin/python -m esports_silo.run.runner --once >> /var/log/esports_silo/collect.log 2>&1
