# esports_silo environment template.
# Real values live in your prod .env (/opt/pa2-shared/.env or local) — NEVER commit real keys.
# This file is a template of NAMES only.

# --- Siloed database (its OWN db, not the 15-bot prod db) ---
DATABASE_URL=postgresql://esports_silo:CHANGE_ME@localhost:5432/esports_silo

# --- Sharp-line source: pinnodds (self-serve Pinnacle wrapper) ---
# LIVE-VERIFIED 2026-07-06: esports = sport_id 11, one /markets call returns all
# events; ~20 req/window rate limit. This is THE odds source (replaces OddsPapi).
PINNODDS_API_KEY=
PINNODDS_BASE=https://pinnodds.com/kit/v1

# --- OddsPapi (ABANDONED — pinnacle was B2B-only there). Kept for legacy scripts. ---
ODDSPAPI_API_KEY=

# --- Match data / results ---
PANDASCORE_API_KEY=

# --- LoL patch + schedule (Riot personal keys EXPIRE every 24h) ---
RIOT_API_KEY=

# --- Polymarket public endpoints (no key; CLOB order-signing key derives from wallet) ---
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com

# --- Book written to odds_raw. pinnodds forwards Pinnacle raw (D3 FINAL 2026-07-06). ---
SHARP_BOOKS=pinnacle

# --- Games in scope ---
ESPORTS_GAMES=cs2,lol,dota2,valorant

# --- Fitted-calibrator artifact (fit_calibrator.py writes; runner --predict reads) ---
CALIBRATOR_PATH=esports_silo/artifacts/calibrator_sharp_consensus_v1.json

# --- Paper bankroll used for (halted) sizing math in forward predictions ---
SILO_BANKROLL_USD=1000

# --- Safety: start HALTED / paper. Flip only after the skill gates pass. ---
SILO_ENTRY_HALT=true
